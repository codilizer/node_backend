# ------------------------------------------------------------
# 환경 변수 예시 파일
#   cp .env.example .env  후 값을 채워서 사용합니다.
#   "#need to specify" 로 표시된 값은 실제 운영 값으로 반드시 교체해야 합니다.
#   서버는 기동 시 process.loadEnvFile() 로 .env 를 읽습니다. (ENV_FILE 로 경로 변경 가능)
# ------------------------------------------------------------

# 실행 환경: localhost | development | staging | production
NODE_ENV=localhost

# 서버 포트
APP_PORT=4000
ADMIN_PORT=3001

# 외부에서 접근하는 URL (메일 링크, 이미지 URL 생성에 사용)
APP_BASE_URL=http://localhost:4000
ADMIN_BASE_URL=http://localhost:3001

# 언어 (app/lang, admin/lang 하위 디렉토리 이름: ko | en)
COUNTRY=ko

# MongoDB
MONGO_URI=mongodb://localhost:27017/node_backend

# MySQL (선택, 사용하지 않으면 MYSQL_ENABLE=false)
MYSQL_ENABLE=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=#need to specify
MYSQL_PASSWORD=#need to specify
MYSQL_DATABASE=node_backend

# Redis (선택, 사용하지 않으면 메모리 캐시/메모리 세션으로 동작. 서버 환경에서는 반드시 true)
REDIS_ENABLE=false
REDIS_URL=redis://localhost:6379

# 세션 서명 키 / 암호화 키 (운영에서는 반드시 긴 랜덤 문자열로 교체)
SESSION_SECRET=#need to specify
ENCRYPT_KEY=#need to specify

# CORS 허용 origin (콤마 구분, * 허용)
CORS_ORIGINS=*

# 메일 (SMTP)
MAIL_ENABLE=false
MAIL_FROM=noreply@example.com
MAIL_SUPPORT=support@example.com
SMTP_HOST=#need to specify
SMTP_PORT=587
SMTP_USER=#need to specify
SMTP_PASS=#need to specify

# 관리자 비상 계정 (DB 에 관리자가 없을 때만 로그인 가능)
#   비밀번호 해시는  npm run hash-password -- <비밀번호>  로 생성합니다.
ADMIN_BOOTSTRAP_ID=admin
ADMIN_BOOTSTRAP_PASSWORD_HASH=#need to specify

# AWS (S3 업로드 등 확장용, 현재는 자리만 마련)
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=#need to specify

# 푸시 알림 (확장용 자리)
APNS_KEY_ID=#need to specify
APNS_TEAM_ID=#need to specify
APNS_BUNDLE_ID=#need to specify
FCM_SERVER_KEY=#need to specify

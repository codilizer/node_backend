{
  "name": "node-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "범용 API 서버 + 관리 페이지 (Hono + TypeScript / React). 로그인, 회원, 공지, 관리자 관리 포함",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node app/server.ts",
    "start:admin": "node admin/server.ts",
    "dev": "NODE_ENV=localhost node --watch app/server.ts",
    "dev:admin": "NODE_ENV=localhost node --watch admin/server.ts",
    "dev:client": "vite --config admin/client/vite.config.ts",
    "build:client": "vite build --config admin/client/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p admin/client/tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "batch:admin-user": "node batch/data/add_admin_user.ts",
    "batch:master-data": "node batch/data/add_master_data.ts",
    "hash-password": "node scripts/hash_password.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs"
  },
  "imports": {
    "#config/*": "./config/*.ts",
    "#lib/*": "./lib/*.ts",
    "#model/*": "./model/*.ts",
    "#doc/*": "./doc/*.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "log4js": "^6.9.1",
    "mongoose": "^8.19.0",
    "mysql2": "^3.15.0",
    "nodemailer": "^10.1.0",
    "redis": "^5.8.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bootstrap": "^5.3.8",
    "mongodb-memory-server": "^10.2.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "license": "MIT"
}
